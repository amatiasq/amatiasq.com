#!/bin/bash -e
# amq amatiasq.com deploy [--skip-build] — build the site here and put it in
# production: dist/ lands in the docroot of whichever nginx is serving the
# domain. No GitHub Pages, no mirror repo, no push — the code you have is the
# code that ships. `--skip-build` ships the dist/ that is already there.
#
# El build es el de `amq amatiasq.com check`, que corre entero y para el deploy
# si algo falla: el frontmatter de un post recién escrito sólo se rompe al
# construir, y enterarse con el rsync a medio camino es tarde. No se construye
# dos veces — el dist/ que sube es el que dejó el check.
#
# infra/www/ (the loose files the routes alias) travels in the same command,
# because forgetting it is how /plot spent days serving a GIF the repo had
# already replaced. Con el nginx común sirviendo, el routing es su conf.d/ —
# `services/nginx-static`— y `amq nginx-static deploy` lo sube al final; con el
# nginx por sitio, su nginx.conf vive en el servidor y esto no lo toca.
# The version stamp takes a -dirty suffix from an unclean tree.

case "$1" in
  -h|--help|help) awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/, ""); print}' "$0"; exit 0;;
esac

VPS_REMOTE_DIR=vps

cd "$(dirname "$0")/.."

if [[ "$1" != "--skip-build" ]]; then
  amq amatiasq.com check
fi

[ -f dist/index.html ] || { echo "no dist/index.html — nothing to deploy" >&2; exit 1; }

# dist/ is gitignored, so what runs in production is otherwise unidentifiable.
# `git status` decides the -dirty suffix: a build from an unclean tree is not
# the commit it claims to be.
echo "==> stamp version"
commit="$(git rev-parse HEAD)"
[ -z "$(git status --porcelain -- . ':!dist')" ] || commit="$commit-dirty"
printf '%s\n%s\n' "$commit" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > dist/version.txt
echo "    $commit"

# El docroot lo decide qué nginx está arriba, no el repo: desde el 2026-09-18
# sirve el común de `services/nginx-static` y la rama de abajo es la vuelta
# atrás, que arranca otra vez el nginx por sitio.
if amq vps ssh 'docker ps --format "{{.Names}}"' | grep -qx nginx-static; then
  SITE_DIR="$VPS_REMOTE_DIR/docker/nginx-static/www/amatiasq.com"
  shared_nginx=1
else
  SITE_DIR="$VPS_REMOTE_DIR/docker/com_amatiasq/www"
  shared_nginx=0
fi
echo "==> docroot: $SITE_DIR"

# No --delete: the server holds a couple of legacy pages this repo never had,
# and the routes still alias them.
echo "==> rsync infra/www/ -> $SITE_DIR/ on the VPS"
amq vps ssh "mkdir -p '$SITE_DIR/site'"
amq vps rsync infra/www/ ":$SITE_DIR/"

# --delete here, and only here: every file under site/ is generated, so a page
# that stopped being built must stop being served. Renaming a route otherwise
# leaves the old URL answering 200 forever.
echo "==> rsync dist/ -> $SITE_DIR/site/ on the VPS"
amq vps rsync --delete dist/ ":$SITE_DIR/site/"

# El nginx por sitio lee del bind mount y no necesita nada; el común sí, que su
# routing viaja aquí.
if [ "$shared_nginx" = 1 ]; then
  amq nginx-static deploy
fi

echo "==> deployed: https://amatiasq.com/ ($commit)"
