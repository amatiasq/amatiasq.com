#!/bin/bash -e
# amq amatiasq.com local — serve the site on this machine with live reload
# (`astro dev`); Ctrl-C stops it. It renders on request and never writes
# dist/ — a dev server writing there would leave a half-built site ready to be
# shipped by the next `deploy --skip-build`. Anything the build resolves and
# the dev server fakes (a renamed image, a dead route) only `amq amatiasq.com
# check` catches. Config (env): PORT (default 4321; a second Astro takes it).

case "$1" in
  -h|--help|help) awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/, ""); print}' "$0"; exit 0;;
esac

amq need bun

PORT="${PORT:-4321}"

if [ ! -d node_modules ]; then
  echo "==> bun install"
  bun install
fi

echo "==> http://localhost:$PORT"
exec bunx astro dev --port "$PORT"
