{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  // infra/www/ and public/ are served verbatim, never built: `/deno.ts` is
  // handed out as text, and the demo bundles crash `astro check` outright.
  "exclude": ["dist", "infra", "public"],
  "compilerOptions": {
    "types": ["node", "bun"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
