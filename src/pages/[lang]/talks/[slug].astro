---
import { getCollection } from 'astro:content';
import { languages } from '@/i18n';
import ContentDetail from '@/components/organisms/ContentDetail.astro';

export async function getStaticPaths() {
  const talks = await getCollection('talks');

  return languages.flatMap((lang) =>
    talks.map((talk) => ({
      params: { lang, slug: talk.id.replace('.md', '') },
      props: { talk, lang },
    }))
  );
}

const { talk, lang } = Astro.props;
---

<ContentDetail entry={talk} lang={lang} links={{ Slides: talk.data.links?.slides, Video: talk.data.links?.video }} />
