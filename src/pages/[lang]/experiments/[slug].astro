---
import { getCollection } from 'astro:content';
import { languages } from '@/i18n';
import ContentDetail from '@/components/organisms/ContentDetail.astro';

export async function getStaticPaths() {
  const experiments = await getCollection('experiments');

  return languages.flatMap((lang) =>
    experiments.map((experiment) => ({
      params: { lang, slug: experiment.id.replace('.md', '') },
      props: { experiment, lang },
    }))
  );
}

const { experiment, lang } = Astro.props;
---

<ContentDetail entry={experiment} lang={lang} links={{ Demo: experiment.data.links?.live, GitHub: experiment.data.links?.github }} />
