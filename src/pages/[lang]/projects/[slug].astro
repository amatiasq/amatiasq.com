---
import { getCollection } from 'astro:content';
import { languages } from '@/i18n';
import ContentDetail from '@/components/organisms/ContentDetail.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return languages.flatMap((lang) =>
    projects.map((project) => ({
      params: { lang, slug: project.id.replace('.md', '') },
      props: { project, lang },
    }))
  );
}

const { project, lang } = Astro.props;
---

<ContentDetail entry={project} lang={lang} links={{ Demo: project.data.links?.live, GitHub: project.data.links?.github }} />
